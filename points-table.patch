+            Every point, from every sport, added up. One table for the whole of Sports Day 2026.
+          </p>
+          <div className="mt-10 flex flex-wrap items-center gap-x-10 gap-y-3 border-t border-primary-foreground/15 pt-6 text-sm text-primary-foreground/80">
+            <span>
+              <span className="font-display text-xl font-extrabold text-primary-foreground">
+                {points.teams.length}
+              </span>{" "}
+              teams
+            </span>
+            <span>
