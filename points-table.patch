+
+/* ------------------------------------------------------------------ *
+ * Leaderboard
+ * ------------------------------------------------------------------ */
+
+function TeamCard({
+  entry,
+  leaderPoints,
+  published,
+}: {
+  entry: Standing;
+  leaderPoints: number;
+  published: boolean;
+}) {
+  const logo = teamLogo(entry.team);
+  const isLeader = published && entry.rank === 1 && leaderPoints > 0;
+  const behind = leaderPoints - entry.total;
+
+  return (
+    <article
+      className={cn(
+        "relative flex flex-col border border-border bg-card p-6 transition-colors",
+        isLeader && "border-accent/60 bg-secondary/40",
+      )}
+    >
+      <span
+        className="absolute inset-x-0 top-0 h-1"
+        style={{ backgroundColor: entry.team.color }}
+        aria-hidden
+      />
+      <div className="flex items-start justify-between gap-3">
+        <span className="font-display text-sm font-bold tabular-nums text-muted-foreground/70">
+          {published ? `#${entry.rank}` : "—"}
+        </span>
+        {isLeader && <span className="eyebrow text-[0.62rem] text-accent">Leading</span>}
+      </div>
+
+      {logo && (
+        <img
+          src={logo}
+          alt=""
+          className="mt-4 h-16 w-16 object-contain object-left"
+          width={64}
+          height={64}
+        />
+      )}
+      <h3 className="mt-4 font-display text-lg font-extrabold leading-tight">{entry.team.name}</h3>
+      <p className="text-sm text-muted-foreground">{entry.team.code}</p>
+
+      <p className="mt-6 font-display text-4xl font-extrabold tabular-nums">
+        {published ? entry.total.toLocaleString() : "—"}
+      </p>
+      <p className="text-xs uppercase tracking-wider text-muted-foreground">
+        {published
+          ? entry.rank === 1
+            ? `points · ${entry.scored} sport${entry.scored === 1 ? "" : "s"} scored`
+            : `points · ${behind.toLocaleString()} behind`
+          : "points"}
+      </p>
+    </article>
+  );
+}
+
+function StandingsTable({
+  standings,
+  leaderPoints,
+  published,
+  sports,
+}: {
+  standings: Standing[];
+  leaderPoints: number;
+  published: boolean;
+  sports: number;
+}) {
+  return (
+    <table className="mt-12 w-full border-collapse text-sm">
+      <thead>
+        <tr className="border-y border-border text-left">
+          <th className="w-12 py-3 pr-3 font-medium text-muted-foreground">#</th>
+          <th className="py-3 pr-4 font-medium text-muted-foreground">Team</th>
+          <th className="hidden py-3 pr-4 text-right font-medium text-muted-foreground sm:table-cell">
+            Sports scored
+          </th>
+          <th className="hidden py-3 pr-6 font-medium text-muted-foreground md:table-cell">
+            Share of points
+          </th>
+          <th className="py-3 text-right font-medium text-muted-foreground">Points</th>
+        </tr>
+      </thead>
+      <tbody>
+        {standings.map((entry) => {
+          const share = leaderPoints > 0 ? (entry.total / leaderPoints) * 100 : 0;
+          return (
+            <tr key={entry.team.code} className="border-b border-border">
+              <td className="py-4 pr-3 font-display font-bold tabular-nums text-muted-foreground/70">
