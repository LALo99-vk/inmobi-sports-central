+          "The overall standings for InMobi Sports Day 2026: every point scored by all four teams, across every sport.",
+      },
+      { property: "og:title", content: "Points Table — InMobi Sports Day 2026" },
+      {
+        property: "og:description",
+        content: "Live overall standings across every tournament of InMobi Sports Day 2026.",
+      },
+    ],
+  }),
+  component: PointsTablePage,
+});
+
+type Standing = {
+  team: Group;
+  total: number;
+  /** Sports this team has been scored in — the rest are still to come. */
+  scored: number;
+  /** Shared by teams on equal points, as a league table should. */
+  rank: number;
+};
+
+function buildStandings(table: PointsTable): Standing[] {
+  const ordered = table.teams
+    .map((team) => ({
+      team,
+      total: table.totals[team.code] ?? 0,
+      scored: table.rows.filter((row) => typeof row.points[team.code] === "number").length,
+    }))
+    .sort((a, b) => b.total - a.total || a.team.name.localeCompare(b.team.name));
+
+  let rank = 0;
+  let previous: number | null = null;
+  return ordered.map((entry, index) => {
+    if (previous === null || entry.total !== previous) rank = index + 1;
+    previous = entry.total;
+    return { ...entry, rank };
+  });
+}
+
+/** Codes tied at the top of a sport's row, so the leader can be marked. */
+function leadersOf(row: PointsRow): Set<string> {
+  const scored = Object.entries(row.points).filter(
+    (entry): entry is [string, number] => typeof entry[1] === "number",
+  );
+  const best = Math.max(...scored.map(([, value]) => value), 0);
+  if (!scored.length || best <= 0) return new Set();
+  return new Set(scored.filter(([, value]) => value === best).map(([code]) => code));
+}
+
