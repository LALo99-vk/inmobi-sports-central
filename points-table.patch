+function buildGroupLookup(groups: Group[]) {
+  const byKey = new Map<string, string>();
+  for (const group of groups) {
+    byKey.set(normalizeHeader(group.code), group.code);
+    byKey.set(normalizeHeader(group.name), group.code);
+  }
+
+  return (value: string): string | undefined => {
+    const key = normalizeHeader(value ?? "");
+    if (!key) return undefined;
+    const exact = byKey.get(key);
+    if (exact) return exact;
+    // Longer labels only: two-letter codes like "TT" would match half the sheet.
+    for (const [candidate, code] of byKey) {
