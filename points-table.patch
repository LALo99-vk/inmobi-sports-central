+ */
+export function parsePointsTab(
+  grid: SheetGrid,
+  groups: Group[],
+  tab = "Points Table",
+): { rows: PointsRow[]; warnings: ParseWarning[] } {
+  const warnings: ParseWarning[] = [];
+  if (!grid.length) return { rows: [], warnings };
+
+  const resolveGroup = buildGroupLookup(groups);
+  const headerHits = (grid[0] ?? []).filter((value) => resolveGroup(value ?? "")).length;
+  const columnHits = grid.slice(1).filter((row) => resolveGroup(row[0] ?? "")).length;
+  const oriented = headerHits < 2 && columnHits >= 2 ? transpose(grid) : grid;
