+    (raw, i) =>
+      !taken.has(i) &&
+      i !== sportColumn &&
+      POINTS_NOTE_HEADERS.includes(normalizeHeader(raw ?? "")),
+  );
+
+  const rows: PointsRow[] = [];
+  oriented.slice(1).forEach((row, i) => {
+    const sport = (row[sportColumn] ?? "").trim();
+    if (!sport) return;
+    // Their own total row: we add the sports up ourselves, so skip it rather
+    // than counting the same points twice.
+    if (POINTS_TOTAL_LABELS.includes(normalizeHeader(sport))) return;
+
+    const points: Record<string, number | null> = {};
+    for (const column of teamColumns) {
+      const raw = (row[column.index] ?? "").trim();
+      const value = parsePointsCell(raw);
+      if (raw && value === null && !POINTS_BLANK_CELLS.includes(normalizeHeader(raw))) {
+        warnings.push({
+          tab,
+          row: i + 2,
+          message: `${sport}: "${raw}" isn't a number, so ${column.code} scored nothing for it.`,
+        });
+      }
+      points[column.code] = value;
+    }
+
+    const note = noteColumn === -1 ? "" : (row[noteColumn] ?? "").trim();
+    rows.push({ sport, points, ...(note ? { note } : {}) });
+  });
+
+  return { rows, warnings };
 }
+
+/** Column sums, so the page never has to trust a hand-typed total. */
+export function totalPoints(rows: PointsRow[], groups: Group[]): Record<string, number> {
+  const totals: Record<string, number> = {};
+  for (const group of groups) totals[group.code] = 0;
+  for (const row of rows) {
+    for (const [code, value] of Object.entries(row.points)) {
+      if (typeof value === "number") totals[code] = (totals[code] ?? 0) + value;
+    }
+  }
+  return totals;
+}
