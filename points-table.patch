+/** Turns a points cell into a number, or null when it holds nothing usable. */
+function parsePointsCell(raw: string): number | null {
+  const value = raw.trim();
+  if (!value || POINTS_BLANK_CELLS.includes(normalizeHeader(value))) return null;
+  const numeric = Number(value.replace(/,/g, ""));
+  return Number.isFinite(numeric) ? numeric : null;
