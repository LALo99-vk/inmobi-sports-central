+                    <span className="block truncate font-display text-base font-bold">
+                      {entry.team.name}
+                    </span>
+                    <span className="block text-xs text-muted-foreground sm:hidden">
+                      {entry.scored} of {sports} sports scored
+                    </span>
+                  </span>
+                </span>
+              </td>
+              <td className="hidden py-4 pr-4 text-right tabular-nums text-muted-foreground sm:table-cell">
+                {entry.scored} / {sports}
+              </td>
+              <td className="hidden py-4 pr-6 md:table-cell">
+                <span className="block h-2 w-full bg-secondary">
+                  <span
+                    className="block h-2 transition-[width] duration-500"
+                    style={{ width: `${share}%`, backgroundColor: entry.team.color }}
+                  />
+                </span>
+              </td>
+              <td className="py-4 text-right font-display text-lg font-extrabold tabular-nums">
+                {published ? entry.total.toLocaleString() : "—"}
+              </td>
+            </tr>
