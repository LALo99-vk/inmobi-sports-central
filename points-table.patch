+  const taken = new Set(teamColumns.map((column) => column.index));
+  // The sport label is whichever spare column is headed "Sport" (or similar);
+  // failing that, the first column the teams didn't claim.
+  const namedLabel = header.findIndex(
+    (raw, i) => !taken.has(i) && POINTS_LABEL_HEADERS.includes(normalizeHeader(raw ?? "")),
